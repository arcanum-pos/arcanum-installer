{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// On the account that will host Arcanum: uploaded there by the
	// bootstrapper (start.kaboutersoft.be, from the latest release) or with
	// the "Deploy to Cloudflare" button (see README). It installs and updates
	// the five Arcanum Workers from the published release bundles
	// (arcanum-pos/arcanum-releases) — and, on an update, itself first.
	"name": "arcanum-installer",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-11",
	// Its setup page lives on workers.dev: admins sign in with their account
	// (bootstrapped) or INSTALLER_PASSWORD (Deploy button).
	"workers_dev": true,
	// The installer's own state: configuration, resource ids, progress, and
	// (encrypted) the Cloudflare token and generated secrets. No id: the
	// Deploy button creates the namespace (the bootstrapper: title
	// arcanum-installer-INSTALLER_STATE).
	"kv_namespaces": [{ "binding": "INSTALLER_STATE" }],
	"vars": {
		// Where the list of releases is read from (not the rate-limited GitHub API).
		"RELEASES_INDEX_URL": "https://raw.githubusercontent.com/arcanum-pos/arcanum-releases/main/releases.json"
	},
	// The logo and fonts (the platform's own: kabouter logo, Geist, Montserrat
	// Bold) are bundled into the Worker as binary modules — the setup page
	// loads nothing from anywhere else.
	"rules": [{ "type": "Data", "globs": ["**/*.png", "**/*.woff2"], "fallthrough": true }],
	"observability": { "enabled": true }
}
